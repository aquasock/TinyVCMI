IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

IO_LOC "uart_rx" V14;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// The AE350 design proved PLL_R[0] as a general-purpose site on this board.
INS_LOC "ddr_pll" PLL_R[0];

INS_LOC "dll" DDRDLLM_BL;

